{
  "name": "ecotrial",
  "version": "0.1.0",
  "description": "Test candidate package releases against real downstream projects before release.",
  "type": "module",
  "bin": {
    "ecotrial": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dogfood": "pnpm build && node dist/cli/index.js run --config ecotrial.yml --json .ecotrial/report.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "license": "Apache-2.0"
}
